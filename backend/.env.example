# Backend configuration. Copy to .env. Defaults run fully offline with no model downloads.
DATABASE_URL=sqlite:///./data/smriti.db
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; add your deployed frontend URL, or * to allow any
DEFAULT_TIMEZONE=Asia/Kolkata

# Adapters: swap implementations here, no code changes needed.
TEXT_EMBEDDER=hash                 # hash | ollama:bge-m3 | st:BAAI/bge-m3
IMAGE_EMBEDDER=none                # none | openclip
VLM=basic                          # basic | ollama:qwen2.5vl:3b
LLM=extractive                     # extractive | ollama:qwen2.5:3b | groq[:model] | auto (local Ollama, else Groq, else extractive)
STT=none                           # none | faster_whisper:small
OLLAMA_BASE_URL=http://localhost:11434

# Behaviour
MAX_UPLOAD_MB=2048
MAX_KEYFRAMES=40
WORKER_CONCURRENCY=2
SEARCH_TOP_K=50

# Google sign-in (optional). OAuth "Web application" client ID; add http://localhost:3000 and http://localhost to its
# Authorized JavaScript origins. Can also be set from Settings by the admin.
GOOGLE_CLIENT_ID=

# Groq (hosted, fast). Used when LLM=groq, or by LLM=auto when no local Ollama model is running.
# Note: chat then sends each question and the matching file excerpts to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
