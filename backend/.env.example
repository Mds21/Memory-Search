# Backend configuration. Copy to .env. Defaults run fully offline with no model downloads.
DATABASE_URL=sqlite:///./data/smriti.db
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# Adapters: swap implementations here, no code changes needed.
TEXT_EMBEDDER=hash                 # hash | ollama:bge-m3 | st:BAAI/bge-m3
IMAGE_EMBEDDER=none                # none | openclip
VLM=basic                          # basic | ollama:qwen2.5vl:3b
LLM=extractive                     # extractive | ollama:qwen2.5:3b
STT=none                           # none | faster_whisper:small
OLLAMA_BASE_URL=http://localhost:11434

# Behaviour
MAX_UPLOAD_MB=2048
MAX_KEYFRAMES=40
WORKER_CONCURRENCY=2
SEARCH_TOP_K=50
