{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "dom.iterable", "esnext"], "allowJs": false, "skipLibCheck": true, "strict": true,
    "noEmit": true, "esModuleInterop": true, "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "preserve", "incremental": true, "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // Unfinished components from an earlier version (accounts, phone sign-in, file facts, sharing). Nothing imports
    // them and they reference APIs that don't exist yet, so they stay out of type checking until finished or removed.
    "components/AccountCards.tsx", "components/AuthForms.tsx", "components/BrowseTiles.tsx", "components/ChatHistory.tsx",
    "components/FileFacts.tsx", "components/PasswordGate.tsx", "components/ShareCard.tsx", "lib/share.ts"
  ]
}
